{
  "name": "@agent-ready/cli",
  "version": "0.2.0",
  "description": "Command-line interface for Agent-Ready Schema.",
  "type": "module",
  "bin": {
    "ars": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "author": "Diego Souza <DiegoSouzadsp> (Orquestra AI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoSouzadsp/agent-ready-core.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@agent-ready/core": "^0.2.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
