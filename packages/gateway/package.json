{
  "name": "@agent-ready/gateway",
  "version": "0.2.0",
  "description": "Generic ARS gateway engine — serves any system as MCP tools from a declarative plugin directory (schemas + executors), no per-system code",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ars-gateway": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "author": "Diego Souza <DiegoSouzadsp> (Orquestra AI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiegoSouzadsp/agent-ready-core.git",
    "directory": "packages/gateway"
  },
  "peerDependencies": {
    "@agent-ready/adapter-mcp": "^0.2.0",
    "@agent-ready/core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "dependencies": {
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@agent-ready/adapter-mcp": "^0.2.0",
    "@agent-ready/core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
