{
  "name": "@agent-ready/adapter-mcp",
  "version": "0.2.0",
  "description": "MCP (Model Context Protocol) bridge for Agent-Ready Schema core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "author": "Diego Souza <DiegoSouzadsp> (Orquestra AI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoSouzadsp/agent-ready-core.git",
    "directory": "packages/adapter-mcp"
  },
  "peerDependencies": {
    "@agent-ready/core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@agent-ready/core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
