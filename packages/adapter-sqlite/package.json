{
  "name": "@agent-ready/adapter-sqlite",
  "version": "0.2.0",
  "description": "SQLite adapter for Agent-Ready Schema core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "author": "Diego Souza <DiegoSouzadsp> (Orquestra AI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoSouzadsp/agent-ready-core.git",
    "directory": "packages/adapter-sqlite"
  },
  "peerDependencies": {
    "@agent-ready/core": "^0.2.0",
    "better-sqlite3": "^11.0.0||^12.0.0"
  },
  "devDependencies": {
    "@agent-ready/core": "^0.2.0",
    "@types/better-sqlite3": "^7.6.11"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
